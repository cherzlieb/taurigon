{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "taurigon",
  "version": "0.1.0",
  "identifier": "com.cherzlieb.taurigon",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "taurigon",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Rootless Web-Dev-Umgebung für Linux",
    "longDescription": "Verwalte Container-basierte Webentwicklungsumgebungen (Nginx, PHP, MariaDB, PostgreSQL, Redis) rootless über eine moderne GUI."
  }
}
